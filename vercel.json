{
  "functions": {
    "api/generate-proposal-pdf.js": {
      "maxDuration": 60
    },
    "api/admin.js": {
      "maxDuration": 60
    },
    "api/dashboard-cron.js": {
      "maxDuration": 300,
      "includeFiles": "data/bing-ai-citas.json"
    }
  },
  "rewrites": [
    {
      "source": "/api/gpt/catalogo",
      "destination": "/api/admin?action=gpt-catalogo"
    },
    {
      "source": "/api/gpt/show",
      "destination": "/api/admin?action=gpt-show"
    },
    {
      "source": "/api/init-opp-proposal",
      "destination": "/api/admin?action=init-opp-proposal"
    },
    {
      "source": "/formulario-cliente",
      "destination": "/formulario-inteligente.html"
    },
    {
      "source": "/formulario-cliente/",
      "destination": "/formulario-inteligente.html"
    },
    {
      "source": "/formulario-artista",
      "destination": "/formulario-artistas.html"
    },
    {
      "source": "/formulario-artista/",
      "destination": "/formulario-artistas.html"
    },
    {
      "source": "/propuesta/:path*",
      "destination": "/propuesta.html"
    },
    {
      "source": "/catalogo",
      "destination": "/propuesta-catalogo.html"
    },
    {
      "source": "/catalogo/",
      "destination": "/propuesta-catalogo.html"
    },
    {
      "source": "/linkedin",
      "destination": "/propuesta-linkedin.html"
    },
    {
      "source": "/linkedin/",
      "destination": "/propuesta-linkedin.html"
    },
    {
      "source": "/metricas",
      "destination": "/dashboard-metricas.html"
    },
    {
      "source": "/metricas/",
      "destination": "/dashboard-metricas.html"
    },
    {
      "source": "/dashboard-metricas",
      "destination": "/dashboard-metricas.html"
    },
    {
      "source": "/dashboard-metricas/",
      "destination": "/dashboard-metricas.html"
    },
    {
      "source": "/dashboard",
      "destination": "/api/dashboard"
    },
    {
      "source": "/dashboard/",
      "destination": "/api/dashboard"
    },
    {
      "source": "/dashboard/historico",
      "destination": "/api/dashboard?lista=1"
    },
    {
      "source": "/dashboard/:fecha(\\d{4}-\\d{2}-\\d{2})",
      "destination": "/api/dashboard?informe=:fecha"
    },
    {
      "source": "/xavi",
      "destination": "/dashboard-xavi.html"
    },
    {
      "source": "/xavi/",
      "destination": "/dashboard-xavi.html"
    },
    {
      "source": "/dashboard-xavi",
      "destination": "/dashboard-xavi.html"
    },
    {
      "source": "/dashboard-xavi/",
      "destination": "/dashboard-xavi.html"
    },
    {
      "source": "/reunion",
      "destination": "/agenda-reunion-xavi.html"
    },
    {
      "source": "/reunion/",
      "destination": "/agenda-reunion-xavi.html"
    },
    {
      "source": "/reunion-xavi",
      "destination": "/agenda-reunion-xavi.html"
    },
    {
      "source": "/reunion-xavi/",
      "destination": "/agenda-reunion-xavi.html"
    },
    {
      "source": "/benchmark",
      "destination": "/OUTPUTS/eventos-barcelona/benchmark-competitivo-sep2026.html"
    },
    {
      "source": "/benchmark/",
      "destination": "/OUTPUTS/eventos-barcelona/benchmark-competitivo-sep2026.html"
    },
    {
      "source": "/sprint-close",
      "destination": "/OUTPUTS/eventos-barcelona/sprint-close-sep2026.html"
    },
    {
      "source": "/sprint-close/",
      "destination": "/OUTPUTS/eventos-barcelona/sprint-close-sep2026.html"
    },
    {
      "source": "/sprint",
      "destination": "/OUTPUTS/eventos-barcelona/sprint-close-sep2026.html"
    },
    {
      "source": "/sprint/",
      "destination": "/OUTPUTS/eventos-barcelona/sprint-close-sep2026.html"
    },
    {
      "source": "/brief",
      "destination": "/OUTPUTS/eventos-barcelona/brief-tecnico-y-contenido.html"
    },
    {
      "source": "/brief/",
      "destination": "/OUTPUTS/eventos-barcelona/brief-tecnico-y-contenido.html"
    },
    {
      "source": "/contacto-opciones",
      "destination": "/OUTPUTS/eventos-barcelona/contacto-opciones.html"
    },
    {
      "source": "/contacto-opciones/",
      "destination": "/OUTPUTS/eventos-barcelona/contacto-opciones.html"
    },
    {
      "source": "/contacto-opciones/a",
      "destination": "/OUTPUTS/eventos-barcelona/contacto-opcion-a.html"
    },
    {
      "source": "/contacto-opciones/b",
      "destination": "/OUTPUTS/eventos-barcelona/contacto-opcion-b.html"
    },
    {
      "source": "/home-nueva",
      "destination": "/OUTPUTS/eventos-barcelona/home-nueva.html"
    },
    {
      "source": "/home-nueva/",
      "destination": "/OUTPUTS/eventos-barcelona/home-nueva.html"
    },
    {
      "source": "/bocetos/",
      "destination": "/OUTPUTS/eventos-barcelona/bocetos-web/index.html"
    },
    {
      "source": "/bocetos/:path*",
      "destination": "/OUTPUTS/eventos-barcelona/bocetos-web/:path*"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET,POST,OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/bocetos",
      "destination": "/bocetos/",
      "permanent": false
    },
    {
      "source": "/home-opciones",
      "destination": "/home-nueva",
      "permanent": false
    },
    {
      "source": "/home-opciones/",
      "destination": "/home-nueva",
      "permanent": false
    },
    {
      "source": "/home-opciones/a",
      "destination": "/home-nueva",
      "permanent": false
    },
    {
      "source": "/home-opciones/b",
      "destination": "/home-nueva",
      "permanent": false
    },
    {
      "source": "/dashboard-resultados.html",
      "destination": "/dashboard",
      "permanent": false
    }
  ],
  "crons": [
    {
      "path": "/api/dashboard-cron",
      "schedule": "0 6 * * 3"
    }
  ]
}
